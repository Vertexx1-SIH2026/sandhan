# Copy this file to backend/.env and adjust values for your machine.

# --- App ---
# Use a long random string (>= 32 chars):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SANDHAN_SECRET_KEY=change-this-to-a-long-random-string-of-at-least-32-chars
SANDHAN_ACCESS_TOKEN_EXPIRE_MINUTES=480
SANDHAN_CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (users, RBAC, audit, historical DB, identifier index) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sandhan
POSTGRES_USER=sandhan
POSTGRES_PASSWORD=sandhan
# Optional full URL override:
# SANDHAN_DATABASE_URL=postgresql+psycopg2://sandhan:sandhan@localhost:5432/sandhan

# --- Graph store ---
# neo4j (default) | memory (automated tests / emergency fallback only)
SANDHAN_GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sandhan123

# --- Linking / NLP tuning (defaults are fine) ---
# How far out the case network reaches through linked cases:
# SANDHAN_CASE_HOPS=2
# Identifiers found in more cases than this never auto-confirm a link:
# SANDHAN_HUB_CASE_LIMIT=5
# SANDHAN_PROBABLE_LINK_MIN_SCORE=0.30
# SBERT cosine threshold -- not yet calibrated:
# SANDHAN_MO_THRESHOLD=0.60
